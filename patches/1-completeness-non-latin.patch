+const wordSegmenter =
+  typeof Intl !== 'undefined' && 'Segmenter' in Intl
+    ? new Intl.Segmenter(undefined, { granularity: 'word' })
+    : undefined;
+
+/**
+ * Splits a token written in a script without spaces between words (Chinese, Japanese, Thai)
+ * into words. ASCII tokens are returned unchanged, so English scores stay the same.
+ */
+function splitUnspacedScript(token: string): string[] {
+  if (!wordSegmenter || /^[a-z0-9]*$/.test(token)) {
+    return [token];
+  }
+
+  return Array.from(wordSegmenter.segment(token))
+    .filter(part => part.isWordLike)
+    .map(part => part.segment);
+}
